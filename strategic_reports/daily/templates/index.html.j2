{% extends "base.html.j2" %}
{% from "_macros.html.j2" import topic_section, overview_block %}

{% block head %}
<title>Strategic Review — {{ date }}</title>
{% endblock %}

{% block body %}
<h1>Strategic Review — {{ date }}</h1>
<p class="meta">
  Updated: {{ updated }}<br>
  <span class="warn">Generated from recent industry news using LLM analysis.
  Apply judgement before acting on any recommendation. <strong>Caveat emptor!</strong></span>
</p>

{% if overview or results %}
<nav class="toc">
  <h2>Table of Contents</h2>
  <ul>
    {% if overview %}
    <li><a href="#strategic-overview">Strategic Overview</a></li>
    {% endif %}
    {% if results %}
    <li>
      Topic-Specific Strategic Insights
      <ul>
        {% for result in results %}
        <li><a href="#{{ result.config.slug | replace('feeds_', '') }}">{{ result.config.title }}</a></li>
        {% endfor %}
      </ul>
    </li>
    {% endif %}
    {% if featured_reports %}
    <li>
      Featured Reports
      <ul>
        {% for report in featured_reports %}
        <li><a href="{{ report.filename }}">{{ report.heading }}</a></li>
        {% endfor %}
      </ul>
    </li>
    {% endif %}
  </ul>
</nav>
{% endif %}

{% if overview %}
{{ overview_block(overview) }}
{% endif %}

{% for result in results %}
{{ topic_section(result, diffs, hours_cutoff) }}
{% endfor %}

<hr style="margin-top:3rem; border:none; border-top:1px solid #ddd;">
<p class="meta">Total tokens used: {{ total_tokens | default(0) }}</p>
{% endblock %}
