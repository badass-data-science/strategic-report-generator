<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% block head %}{% endblock %}
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 1rem;
      line-height: 1.7;
      color: #1a1a1a;
      max-width: 860px;
      margin: 2.5rem auto;
      padding: 0 1.5rem;
    }
    h1 { font-size: 1.6rem; border-bottom: 2px solid #ddd; padding-bottom: .5rem; }
    h2 { font-size: 1.2rem; margin-top: 2.2rem; color: #111; }
    h3 { font-size: 1rem; margin-top: 1.5rem; margin-bottom: .25rem; }
    a { color: #0057b8; text-decoration: none; }
    a:hover { text-decoration: underline; }
    ul { padding-left: 1.4rem; margin: .5rem 0; }
    li { margin: .3rem 0; }
    .meta { color: #555; font-size: .9rem; margin-top: .25rem; }
    .tags { color: #555; font-size: .85rem; }
    .warn { color: #b00; font-style: italic; }
    section + section { border-top: 1px solid #e8e8e8; margin-top: 2rem; padding-top: 1.5rem; }
    .source-link { font-size: .9rem; margin-top: .5rem; }
    .error-note { background: #fff3cd; border: 1px solid #ffc107;
                  padding: .5rem .75rem; border-radius: 4px; font-size: .9rem; }

    /* Report-page styles shared by index.html.j2 and featured_report.html.j2
       (see _macros.html.j2). */
    .overview {
      background: #f0f4ff;
      border-left: 4px solid #4a6cf7;
      border-radius: 4px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0 2rem;
    }
    .overview h2 {
      margin-top: 0;
      font-size: 1.1rem;
      color: #2a3eb1;
    }
    .overview ul { margin: .4rem 0 0; }
    .bullet-diff { margin-top: .75rem; padding: .6rem .9rem; background: #f9f9f9; border-radius: 4px; font-size: .9rem; }
    .diff-label { margin: .4rem 0 .2rem; font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; color: #666; }
    .diff-new { margin: 0 0 .5rem 1.2rem; padding: 0; color: #1a7a3c; }
    .diff-dropped { margin: 0 0 0 1.2rem; padding: 0; color: #999; text-decoration: line-through; }
    .toc {
      background: #f9f9f9;
      border: 1px solid #e8e8e8;
      border-radius: 4px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0 2rem;
    }
    .toc h2 { margin-top: 0; font-size: 1.1rem; color: #111; }
    .toc ul { margin: .4rem 0 0; }
    .toc ul ul { margin: .3rem 0 .3rem .2rem; }
  </style>
</head>
<body>
  {% block body %}{% endblock %}
</body>
</html>
