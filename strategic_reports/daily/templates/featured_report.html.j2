{% extends "base.html.j2" %}
{% from "_macros.html.j2" import topic_section %}

{% block head %}
<title>{{ report.title }} — {{ date }}</title>
<style>
  section.featured {
    border-left: 4px solid #4a6cf7;
    padding-left: 1rem;
  }
  {# Shared viewer styles from tag_graph.py (a Python constant, not user data). #}
  {{ tag_graph_css | safe }}
  /* Taller than the shared default (560px) so more of the graph fits at the
     readable initial zoom. */
  #tag-graph-root .tg-canvas { height: 700px; }
</style>
{% endblock %}

{% block body %}
{% set results = featured_results + related_results %}
<h1>{{ report.title }} — {{ date }}</h1>
<p class="meta">

  <span class="warn">Generated from recent industry news using LLM analysis.
  Apply judgement before acting on any recommendation. <strong>Caveat emptor!</strong></span>
  <br><br>

  Updated: {{ updated }}
  <br><br>

  {# knowledge_graph.ttl sits next to the report pages on the published site
     (publishing_dag copies both into reports/daily-strategic-report/). In the
     local pipeline output it's one level up (output_dir.parent), so this
     link only resolves on the published site. #}
  Download the knowledge graph for this report: <a href="knowledge_graph.ttl">knowledge_graph.ttl</a>
  <br>

  Questions? Comments? Please email Emily Williams at 
  <a href="mailto:emw314159@gmail.com">emw314159@gmail.com</a>.
  <br>
</p>

{% if results %}
<nav class="toc">
  <h2>Table of Contents</h2>
  <ul>
    {% if featured_results %}
    <li>
      Featured Topics
      <ul>
        {% for result in featured_results %}
        <li><a href="#{{ result.config.slug | replace('feeds_', '') }}">{{ result.config.title }}</a></li>
        {% endfor %}
      </ul>
    </li>
    {% endif %}
    {% if results %}
    <li><a href="#tag-network">Source Article Tag Network</a></li>
    {% endif %}
    {% if related_results %}
    <li>
      Related Topics
      <ul>
        {% for result in related_results %}
        <li><a href="#{{ result.config.slug | replace('feeds_', '') }}">{{ result.config.title }}</a></li>
        {% endfor %}
      </ul>
    </li>
    {% endif %}
  </ul>
</nav>
{% endif %}

{% for result in featured_results %}
{{ topic_section(result, diffs, hours_cutoff, "featured") }}
{% endfor %}

{% if results %}
<section id="tag-network">
  <h2>Source Article Tag Network</h2>
  {% if tag_graph.nodes %}
  <p class="meta">
    Tags co-occurring in the same article, across this report's topics only. Color = community
    cluster (recomputed for these topics, so it won't match the full tag graph) or topic, via the
    toggle. Node size = article count · edge thickness = co-occurrence count. Scroll to zoom,
    drag to pan or reposition nodes.
  </p>
  <div class="tag-graph" id="tag-graph-root"></div>
  {% else %}
  <p class="meta">Not enough tag co-occurrence across these topics this run to draw a graph.</p>
  {% endif %}
</section>
{% endif %}

{% for result in related_results %}
{{ topic_section(result, diffs, hours_cutoff) }}
{% endfor %}

<hr style="margin-top:3rem; border:none; border-top:1px solid #ddd;">
<p class="meta">Total tokens used: {{ total_tokens | default(0) }}</p>

{% if results and tag_graph.nodes %}
<script src="{{ tag_graph_d3_url }}"></script>
<script>
{# tag_graph_js is a Python constant; tag_graph_json is escaped by script_safe_json(). #}
{{ tag_graph_js | safe }}
mountTagGraph(document.getElementById("tag-graph-root"), {{ tag_graph_json | safe }}, { topicToggle: true, fitToView: true });
</script>
{% endif %}
{% endblock %}
