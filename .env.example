# Copy to .env (gitignored) and fill in real values for local dev.
# In production, systemd's EnvironmentFile=.env injects these directly —
# nothing in this project loads .env for you except load_dotenv() at the
# top of cli.py / flows/daily_report.py (see those files).

# PostgreSQL tracking database. With the local `docker-compose up -d`
# postgres service (see docker-compose.yml), this is:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strategic_reports

# LLM provider config — see README for details.
# LLM_MODEL=ollama_chat/glm-5.2:cloud
# OLLAMA_API_BASE=http://your-ollama-server:11434
# OLLAMA_API_KEY=your-key-if-required
